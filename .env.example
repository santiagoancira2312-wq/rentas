# Copia este archivo como .env.local y llena los valores del proyecto de Supabase
# (Project Settings → API). Nunca subas .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Identificador de la propiedad que administra esta instalación.
# Lo devuelve la carga inicial; si creas la propiedad desde la app, cópialo de ahí.
NEXT_PUBLIC_PROPERTY_ID=10000000-0000-0000-0000-000000000001
